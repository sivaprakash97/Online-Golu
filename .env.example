# Supabase project settings (Project Settings -> API). Leave empty to run with the in-memory demo store.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog (funnels, session replay, heatmaps). Optional: leave empty and PostHog stays off.
VITE_POSTHOG_KEY=
# EU project? use https://eu.i.posthog.com
VITE_POSTHOG_HOST=
